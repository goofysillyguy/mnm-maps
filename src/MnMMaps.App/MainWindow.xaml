<Window x:Class="MnMMaps.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MnMMaps"
        Title="MnM Maps" Icon="Assets/MnMMaps.ico" Width="880" Height="700" MinWidth="620" MinHeight="440"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="#F4F0E7" FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen">
    <Border Background="#1D2329" BorderBrush="#5B5141" BorderThickness="1" CornerRadius="10" Padding="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Background="#252B31" CornerRadius="8,8,0,0" MouseLeftButtonDown="Title_Drag">
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="MnM Maps" Foreground="{StaticResource Gold}" FontWeight="SemiBold" FontSize="17"/>
                        <TextBlock Text=" /  YOUR FIELD ATLAS" Foreground="{StaticResource Muted}" FontSize="9" Margin="12,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="?" Click="Help_Click" ToolTip="Controls and credits" Padding="10,4"/>
                        <Button Content="Hide" Click="Hide_Click" ToolTip="Ctrl+Shift+M to show or hide" Padding="10,4"/>
                        <Button Content="&#x2715;" Click="Quit_Click" ToolTip="Quit MnM Maps" Padding="10,4" Margin="0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DockPanel Grid.Row="1" Margin="12,10,12,0">
                <Button DockPanel.Dock="Right" Content="Import image…" Click="Import_Click" Margin="8,0,0,0" ToolTip="Add a map you saved yourself (PNG, JPEG, GIF, BMP or TIFF)"/>
                <Button DockPanel.Dock="Right" x:Name="SourceButton" Content="Wiki source ↗" Click="Source_Click" Margin="8,0,0,0" ToolTip="Open the image's wiki page for authorship, revisions and licensing"/>
                <ComboBox x:Name="MapPicker" SelectionChanged="Map_Changed" DisplayMemberPath="Name"
                          IsTextSearchEnabled="True" Foreground="#17212A" Padding="9,7" FontSize="13" ToolTip="Select a map manually. Type its first letters to jump to it."/>
            </DockPanel>
            <DockPanel Grid.Row="2" Margin="12,9,12,9">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox x:Name="TopmostBox" Content="On top" IsChecked="True" Click="Topmost_Click" Margin="4,0,10,0"/>
                    <TextBlock Text="Opacity" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,6,0"/>
                    <Slider x:Name="OpacitySlider" Minimum="0.4" Maximum="1" Value="0.95" Width="68" VerticalAlignment="Center" ValueChanged="Opacity_Changed" ToolTip="Overlay opacity"/>
                </StackPanel>
                <WrapPanel>
                    <Button Content="−" Click="ZoomOut_Click" ToolTip="Zoom out" Padding="11,5"/>
                    <Button Content="+" Click="ZoomIn_Click" ToolTip="Zoom in" Padding="11,5"/>
                    <Button Content="Fit" Click="Fit_Click" Padding="10,5"/>
                    <Button x:Name="AddPinButton" Content="Add pin" Click="AddPin_Click" Padding="10,5"/>
                    <Button x:Name="PinsButton" Content="Pins (0)" Click="Pins_Click" Padding="10,5"/>
                    <Button x:Name="LockButton" Content="Lock" Click="Lock_Click" Padding="10,5" ToolTip="Let mouse clicks pass to the game. Ctrl+Shift+L unlocks."/>
                </WrapPanel>
            </DockPanel>
            <Grid Grid.Row="3" Margin="10,0,10,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="PinsColumn" Width="0"/></Grid.ColumnDefinitions>
                <Border BorderBrush="#384048" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                    <Grid>
                        <local:MapSurface x:Name="MapCanvas"/>
                        <Border x:Name="EmptyPanel" Background="#E610151A" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" CornerRadius="8">
                            <StackPanel>
                                <TextBlock x:Name="EmptyTitle" Text="Choose a map" FontSize="18" Foreground="{StaticResource Gold}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="EmptyDetail" Text="Wiki maps download when selected and stay available offline." Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}"/>
                                <Button x:Name="RetryButton" Content="Retry download" Click="Retry_Click" HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Padding="9,5" Background="#DA151A1F" CornerRadius="4" IsHitTestVisible="False">
                            <TextBlock x:Name="ZoomText" Text="100% · scroll to zoom / drag to pan" Foreground="#DDDBD5" FontSize="10"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Background="#171D23" Margin="8,0,0,0" Padding="10" CornerRadius="4" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,9"><TextBlock Text="PERSONAL PINS" FontSize="10" Foreground="{StaticResource Gold}"/><TextBlock Text="Select a pin to center the map." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                        <ListBox Grid.Row="1" x:Name="PinList" Background="Transparent" Foreground="#F4F0E7" BorderThickness="0" SelectionChanged="Pin_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap" Padding="3,6" ToolTip="{Binding Notes}"/></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="2" x:Name="PinNotes" TextWrapping="Wrap" MaxHeight="100" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" Margin="0,8,0,10" FontSize="11"/>
                        <StackPanel Grid.Row="3" Orientation="Horizontal"><Button Content="Edit" Click="EditPin_Click" Padding="10,6"/><Button Content="Remove" Click="RemovePin_Click" Padding="10,6"/></StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <StackPanel Grid.Row="4" Margin="14,9,22,11">
                <TextBlock x:Name="StatusText" Text="Ctrl+Shift+M: show / hide   ·   Ctrl+Shift+L: click-through" Foreground="{StaticResource Gold}" FontSize="10" TextWrapping="Wrap"/>
                <TextBlock x:Name="CreditText" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <ResizeGrip Grid.Row="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"/>
        </Grid>
    </Border>
</Window>
